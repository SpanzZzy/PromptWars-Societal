# SignalBridge Environment Variables

# Server-side Gemini API Key (obtain from https://aistudio.google.com/apikey)
# If omitted or invalid, SignalBridge will operate in Demo Mode and offer the optional user-provided backup key flow.
GEMINI_API_KEY=

# Admin Demo Authentication (Server-Side)
ADMIN_USERNAME=admin
# Hashed password credentials using scrypt: <salt>:<hash>
# Generate using: node -e "const c=require('crypto'), s=c.randomBytes(16).toString('hex'), h=c.scryptSync('your_password', s, 64).toString('hex'); console.log(s+':'+h)"
ADMIN_PASSWORD_HASH=

# Secure Cookie Session Secret (64+ character random hex)
ADMIN_SESSION_SECRET=

# Public Map Configuration
# Leaflet OSM Tile Provider endpoint
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
